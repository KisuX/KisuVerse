{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AdminEmails": [ "your-admin-email@example.com" ],
  "AllowedOrigins": [ "http://localhost:5173", "https://your-username.github.io" ],
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=KisuVerseDb;Username=postgres;Password=YOUR_DB_PASSWORD"
  },
  "TMDB": {
    "BaseUrl": "https://api.themoviedb.org/3/",
    "ApiKey": "YOUR_TMDB_API_KEY"
  },
  "Jwt": {
    "Key": "YOUR_RANDOM_JWT_SIGNING_KEY_AT_LEAST_32_CHARS",
    "Issuer": "KisuVerse.Api",
    "Audience": "KisuVerse.Client",
    "ExpireMinutes": 15
  }
}
